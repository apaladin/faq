# --- OpenAI (required for AI FAQ demo + chat server) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# FAQ demo defaults to gpt-4o-mini in lib/faq.js when unset there;
# set explicitly for both chat + FAQ:
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
PORT=3000
# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=*

# ============================================================
# Optional: shopping chat assistant (existing /chat + widget)
# ============================================================
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_token_here
STORE_DESCRIPTION=Your store description.

# Client-side Flora MVP (soulara-mvp.html) needs no env vars —
# paste the key in the browser or use data-openai-key on preview themes only.
